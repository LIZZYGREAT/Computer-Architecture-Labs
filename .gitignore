# Local/private notes
/docs/private/

# Vivado project and simulation build products
**/.Xil/
**/*.cache/
**/*.gen/
**/*.hw/
**/*.ip_user_files/
**/*.runs/
**/*.sim/
**/xsim.dir/
*.jou
*.pb

# Generated logs are ignored except for the Lab3/Lab4 evidence indexed by the reports.
*.log
!results/lab3_lab4/**/*.log

# Waveform and programming outputs. Keep the representative verified waveform.
*.wdb
!results/lab3_lab4/lab4-20261021T085125Z/hazard-directed-forwarding.wdb
*.wcfg
*.vcd
*.vpd
*.fst
*.wlf
*.saif
*.str
*.bit
*.mcs
*.ltx

# Rebuildable IP output products; keep .xci, HDL wrappers, and memory images.
**/rtl/xilinx_ip/**/doc/
**/rtl/xilinx_ip/**/hdl/
**/rtl/xilinx_ip/**/misc/
**/rtl/xilinx_ip/**/sim/
**/rtl/xilinx_ip/**/simulation/
**/rtl/xilinx_ip/**/synth/
**/rtl/xilinx_ip/**/*.dcp
**/rtl/xilinx_ip/**/*_sim_netlist.v
**/rtl/xilinx_ip/**/*_sim_netlist.vhdl
**/rtl/xilinx_ip/**/*_stub.v
**/rtl/xilinx_ip/**/*_stub.vhdl
**/rtl/xilinx_ip/**/*.vho
**/rtl/xilinx_ip/**/*.veo
**/rtl/xilinx_ip/**/inst_ram.mif

# Per-run copies of the reference CPU are reproducible from lab3/CPU_CDE.
results/**/reference/

# Temporary instruction-memory copies staged by the Lab3/Lab4 verification script.
results/lab3_lab4/lab[34]-*/sim-inst_ram.mif

# Rebuildable MIPS toolchain outputs. MIF/COE ROM images remain trackable inputs.
**/obj/*.elf
**/obj/*.bin
**/obj/*.data
**/obj/*.o
**/obj/*.s
**/obj/*.map
**/obj/*.d

# Python and local environment artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

